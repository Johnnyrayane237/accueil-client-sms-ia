# Accueil client IA par SMS (fiches 1.1 et 1.5) : modèle du fichier .env
# Copie ce fichier sous le nom .env, puis remplis chaque valeur après le signe =.
# Le .env reste sur ton ordinateur : il n'est jamais publié.
# L'entreprise, ses horaires et les textes des SMS sont dans config-client.json.

# Clé d'accès de tous les webhooks (?cle=...) : une longue chaîne aléatoire
CLE_ACCUEIL=

# Ids des tables de données n8n
# TABLE_RDV : l'agenda. Mets l'id de la table d'un agent vocal (même format) pour partager son agenda.
TABLE_RDV=
TABLE_MESSAGES=
TABLE_CONVERSATIONS=
TABLE_ATTENTE=

# Portable du responsable (alertes), format international (+33...)
NUMERO_DIRIGEANT=

# oui : envoi des SMS par Twilio (compte payant nécessaire) · non : SMS affichés seulement sur la page de démo
SMS_ACTIFS=non
# Numéro Twilio qui envoie les SMS (format international)
NUMERO_SMS_TWILIO=

# Vrai(s) portable(s) de test, format international, séparés par des virgules.
# En démo, ce sont les seuls numéros qui peuvent recevoir de vrais SMS.
NUMEROS_REELS=

# Ids des identifiants n8n (pas les clés API : elles restent chiffrées dans n8n)
TWILIO_IDENTIFIANT=
ANTHROPIC_IDENTIFIANT=
NTFY_IDENTIFIANT=
# Adresse du sujet ntfy des alertes (facultatif : sinon celle de config-client.json)
NTFY_URL=
